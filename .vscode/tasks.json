{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile and run",
            "type": "shell",
            "command": "mkdir -p bin && /opt/homebrew/bin/g++-16 -std=c++17 \"${file}\" -o \"bin/${fileBasenameNoExtension}\" && touch \"${fileBasenameNoExtension}_input.txt\" && \"./bin/${fileBasenameNoExtension}\" < \"${fileBasenameNoExtension}_input.txt\" > \"${fileBasenameNoExtension}_output.txt\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
