{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Compile and Run",
            "type": "shell",
            "command": "mkdir -p bin && /opt/homebrew/bin/g++-16 -std=c++17 \"${file}\" -o \"bin/${fileBasenameNoExtension}\" && touch \"${fileBasenameNoExtension}_input.txt\" && \"./bin/${fileBasenameNoExtension}\" < \"${fileBasenameNoExtension}_input.txt\" > \"${fileBasenameNoExtension}_output.txt\"",
            "problemMatcher": []
        },
        {
            "label": "Java: Compile and Run",
            "type": "shell",
            "command": "mkdir -p bin && /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home/bin/javac -d bin \"${file}\" && touch \"${fileBasenameNoExtension}_input.txt\" && /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home/bin/java -cp bin \"${fileBasenameNoExtension}\" < \"${fileBasenameNoExtension}_input.txt\" > \"${fileBasenameNoExtension}_output.txt\"",
            "problemMatcher": []
        }
    ]
}
